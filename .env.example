# Supabase browser and server session configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase administration key. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only OpenRouter key. Every AI call goes through OpenRouter (ADR 0078). Never expose to browser code.
OPENROUTER_API_KEY=
# Optional: site URL sent to OpenRouter for app attribution.
OPENROUTER_APP_URL=
# Continuous model evaluation (cron /api/cron/ai-model-evaluation). Defaults shown.
AI_EVAL_GRADER_MODEL=anthropic/claude-sonnet-5.5
AI_EVAL_RUN_BUDGET_USD=0.5
AI_EVAL_MODELS_PER_TASK=2
# Comma-separated OpenRouter provider prefixes the evaluator may consider (empty = built-in list).
AI_EVAL_PROVIDER_PREFIXES=

# Direct PostgreSQL connection used by migrations, seeds, and server repositories.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local loopback development only. Production code always ignores this fallback.
ACADEMY_LOCAL_BOOTSTRAP_ENABLED=false

# Optional demo feedback experience
DEMO_MODE_ENABLED=false
NEXT_PUBLIC_DEMO_MODE_ENABLED=false
NEXT_PUBLIC_DEMO_VERSION=local

# Optional external LMS launch configuration
MOODLE_LAUNCH_BASE_URL=
MOODLE_LAUNCH_MODE=
CANVAS_LAUNCH_BASE_URL=
CANVAS_LAUNCH_MODE=

# Email delivery provider (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@churchcoreacademy.com

# Vercel Cron authentication
CRON_SECRET=
