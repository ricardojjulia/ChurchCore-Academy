{
  "name": "churchcore-academy",
  "version": "0.10.0",
  "description": "Multi-tenant education management and student information platform for faith-based institutions.",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "ChurchCore Academy contributors",
  "homepage": "https://github.com/ricardojjulia/ChurchCore-Academy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardojjulia/ChurchCore-Academy.git"
  },
  "bugs": {
    "url": "https://github.com/ricardojjulia/ChurchCore-Academy/issues"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "lint": "eslint",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:full": "node --import tsx scripts/e2e/run.ts",
    "verify": "npm test && npm run lint && npm run build",
    "verify:admissions-rls": "node --env-file=.env.local --import tsx scripts/verify-admissions-rls.ts",
    "verify:enrollment-conversion-rls": "node --env-file=.env.local --import tsx scripts/verify-enrollment-conversion-rls.ts",
    "verify:llis-consent-rls": "node --env-file=.env.local --import tsx scripts/verify-llis-consent-rls.ts",
    "verify:migration-seed-rehearsal": "node --env-file=.env.local --import tsx scripts/verify-migration-seed-rehearsal.ts",
    "verify:ministry-formation-schema": "node --env-file=.env.local --import tsx scripts/verify-ministry-formation-schema.ts",
    "verify:role-walkthrough": "node --env-file=.env.local --import tsx scripts/generate-authenticated-role-walkthrough.ts",
    "db:migrate:local": "node --env-file=.env.local --import tsx scripts/db-migrate-local.ts",
    "db:seed:local": "node --env-file=.env.local --import tsx scripts/db-seed-local.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "jszip": "3.10.2",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "resend": "^6.28.1",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.3"
  },
  "overrides": {
    "postcss@<8.5.10": "8.5.10",
    "@react-pdf/render": "4.5.1",
    "@react-pdf/layout": "4.6.1",
    "@react-pdf/textkit": "6.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "agent-browser": "^0.38.1",
    "autoprefixer": "^10.6.1",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
